{
  "name": "civil-open-data-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "description": "土木建設オープンデータ統合分析基盤 - Civil Open Data Intelligence Platform",
  "engines": {
    "node": ">=20.9 <26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "start:checked": "node scripts/tools/validate-env.js --mode ${CODIP_ENV_MODE:-production} && next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "release:validate-env:local": "DATABASE_URL='file:./dev.db' node scripts/tools/validate-env.js --mode local",
    "release:validate-env:preview": "node scripts/tools/validate-env.js --mode preview",
    "release:validate-env:production": "node scripts/tools/validate-env.js --mode production",
    "release:validate-env:production-target": "node scripts/tools/validate-production-target-env.js",
    "release:smoke": "node scripts/tools/release-smoke.js",
    "release:gate": "node scripts/tools/release-gate.js",
    "db:check-duplicates": "node scripts/tools/check-duplicate-official-urls.js",
    "db:check-standard-record-policy": "node scripts/tools/check-standard-record-policy.js",
    "release:check-v1-contract": "node scripts/tools/check-v1-standard-record-contract.js",
    "release:check-doc-api-contract": "node scripts/tools/check-doc-api-contract.js",
    "release:check-openapi-coverage": "node scripts/tools/check-openapi-route-coverage.js",
    "release:check-docker-contract": "node scripts/tools/check-docker-release-contract.js",
    "release:check-cloudflare-contract": "node scripts/tools/check-cloudflare-neon-contract.js",
    "release:check-github-actions-contract": "node scripts/tools/check-github-actions-contract.js",
    "db:pg:check-postgis-ddl": "node scripts/tools/check-postgis-standard-record-ddl.js",
    "db:generate": "DATABASE_URL='file:./dev.db' prisma generate && npm run db:pg:generate",
    "db:compare-schemas": "node scripts/tools/compare-prisma-models.js",
    "db:pg:validate": "DATABASE_URL='postgresql://codip:codip@localhost:5432/codip?schema=public' prisma validate --schema prisma/postgresql/schema.prisma",
    "db:pg:generate": "DATABASE_URL='postgresql://codip:codip@localhost:5432/codip?schema=public' prisma generate --schema prisma/postgresql/schema.prisma",
    "db:pg:check-drift": "node scripts/tools/check-postgresql-migration-drift.js",
    "db:pg:seed": "tsx prisma/seed-postgresql.ts",
    "db:prune": "node scripts/db/prune-operational-data.js",
    "db:migrate": "DATABASE_URL='file:./dev.db' prisma migrate deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "cf:typegen": "wrangler types",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "leaflet": "^1.9.4",
    "next": "^16.2.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.61.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.16",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "postcss": "^8.5.16"
  }
}
