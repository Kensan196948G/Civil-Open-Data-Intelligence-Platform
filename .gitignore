# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# env / secrets (絶対にコミットしない)
.env
.env.local
.env*.local
.dev.vars
.dev.vars*
# MVP review environment operator artifacts (admin token is a live secret)
.mvp-admin-token.txt

# Cloudflare Workers / OpenNext ビルド成果物
.wrangler/
.open-next/
worker-configuration.d.ts

# Terraform (state / 実値変数は絶対にコミットしない)
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/terraform.tfvars
infra/**/*.auto.tfvars

# database
*.db
*.db-journal
prisma/dev.db*

# fetched sample data
data/samples/*
data/exports/*
!data/samples/.gitkeep
!data/exports/.gitkeep

# test
coverage/
test-results/
playwright-report/

# backups
backups/

# local tooling
.claude/
.mcp.json
state.json

# claudeos internal reports (ルート直下のみ。src/app/reports/ 等のアプリ画面は除外しない)
/reports/

# ClaudeOS agent team worktrees. git は「登録済み」の linked worktree のパスを
# status から隠すため、登録中は無視指定が無くても表に出てこない。しかし worktree
# 登録を解除 / prune した瞬間に全ファイルが untracked として現れ、`git add -A` で
# リポジトリ全体を二重commitしうる。登録状態に依存しない形で明示的に無視する。
# (lint / typecheck 側の除外は eslint.config.mjs と tsconfig.json)
.worktrees/
_worktrees/

# Codex/agent runtime state (internal only, never commit)
.omo/
