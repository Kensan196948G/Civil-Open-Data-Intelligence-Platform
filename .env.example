# SQLite database (prisma/ ディレクトリ基準の相対パス)
DATABASE_URL="file:./dev.db"

# Production example:
# DATABASE_URL="postgresql://user:password@host/db?schema=public&sslmode=require"
# 外部PostgreSQL/Neon等をproductionで使う場合は sslmode=require または verify-full を必ず指定

# 実行モード。local / preview / production のいずれか。未指定時は production 扱い。
# preview または production を指定すると strict runtime mode となり、
# CODIP_ALLOW_INSECURE_ADMIN / CODIP_ALLOW_INSECURE_LOCAL_COOKIES による
# 無認証・非セキュアCookieの緩和が一切効かなくなる (src/lib/admin-auth.ts)。
# ローカル開発以外では未指定のままにするか、明示的に preview / production を設定すること。
CODIP_ENV_MODE=""

# 実ターゲット検証用。release:gate内の合成production検証とは別に、
# staging/productionのSecretsを読み込んで npm run release:validate-env:production-target を実行する
CODIP_DEPLOY_TARGET=""

# Cloudflare/Hyperdrive本番構成の運用メモ用。実接続値はCloudflare側Secret/Bindingで管理する
CODIP_HYPERDRIVE_BINDING=""
CODIP_NEON_BRANCH=""
CODIP_MIGRATION_DATABASE_URL=""

# 共有プレビューでSQLiteを使う場合だけ true。本番では使用禁止
CODIP_ACCEPT_SQLITE_PREVIEW="false"

# Docker preview 起動時に初期データを投入する場合のみ true
CODIP_SEED_ON_START="false"

# Docker preview 等の単一インスタンス検証でのみ、起動時migrationを許可
# 本番では one-off release job で migration を実行し、この値は false のままにする
CODIP_RUN_MIGRATIONS_ON_START="false"

# release smoke の対象URL
# local/previewでは起動中のURL、本番実ターゲット検証では https://odip.mirai-dx-platform.com
CODIP_BASE_URL="http://127.0.0.1:3100"

# 運用ログ・サンプルレスポンスの保持日数
CODIP_FETCH_LOG_RETENTION_DAYS="90"
CODIP_SAMPLE_RETENTION_DAYS="30"

# 本番・共有プレビュー環境の管理操作保護
# 共有プレビュー・本番では32文字以上のランダム値を設定
# 設定すると、登録・編集・削除・取得実行・品質再計算APIで同じ値の x-codip-admin-token が必要になります
CODIP_ADMIN_TOKEN=""

# Cloudflare Access等の前段認証を正とする環境で、直接トークンヘッダーと
# トークンによる新規管理セッション開始を無効化する。preview/productionでは
# CODIP_TRUST_PROXY_AUTH=true と proxy secret + 管理者allowlist が必須。
CODIP_DISABLE_TOKEN_AUTH="false"

# 管理セッションCookieのCSRF対策で許可する追加Origin。通常は空でよい
# 例: https://odip.mirai-dx-platform.com
CODIP_ALLOWED_ORIGINS=""

# ローカル開発でのみ管理操作を無認証許可する明示フラグ
# 本番・共有プレビューでは絶対に true にしないこと
CODIP_ALLOW_INSECURE_ADMIN="false"

# ローカルHTTPで next start を検証する場合のみ、管理CookieのSecure強制を解除
# 本番・共有プレビューでは絶対に true にしないこと
CODIP_ALLOW_INSECURE_LOCAL_COOKIES="false"

# Cloudflare Access等のプロキシ認証済みヘッダーを信頼する場合のみ true
CODIP_TRUST_PROXY_AUTH="false"

# Cloudflare等の信頼済みプロキシ配下でのみ、cf-connecting-ip / x-forwarded-for をレート制限に使う
CODIP_TRUST_PROXY_HEADERS="false"

# CODIP_TRUST_PROXY_AUTH=true の場合に、プロキシ側で付与する共有シークレット
# 直接アクセスで cf-access-authenticated-user-email を偽装されることを防ぐため必須
CODIP_TRUST_PROXY_SECRET=""

# Cloudflare Access等で管理者として扱うメールアドレス・ドメイン
# CODIP_TRUST_PROXY_AUTH=true の場合はいずれかを必ず設定
CODIP_ADMIN_EMAILS=""
CODIP_ADMIN_EMAIL_DOMAINS=""

# ローカル/共有previewでウォッチリストUIを操作するためのデモ識別子（2つ揃って有効）
# Access が無い環境で、管理セッション認証済みリクエストのウォッチリストをこの
# メールアドレスの登録として扱う。本番では絶対に設定しないこと。
CODIP_DEMO_IDENTITY="false"
CODIP_DEMO_USER_EMAIL="demo.engineer@example.com"

# 実ターゲット監視証跡。値そのものは production-evidence で出力しない。
# GitHub environment variables 等に、Cloudflare Access、通知先・Cloudflare logs/alerts・Neon monitoring・smoke監視・rollback owner・backup/restore rehearsalの証跡名を記録する。
CODIP_CLOUDFLARE_ACCESS_EVIDENCE=""
CODIP_MONITORING_CONTACTS=""
CODIP_CLOUDFLARE_ALERT_POLICY=""
CODIP_CLOUDFLARE_LOGS_EVIDENCE=""
CODIP_NEON_MONITORING_EVIDENCE=""
CODIP_SMOKE_MONITORING_SCHEDULE=""
CODIP_ROLLBACK_OWNER=""
CODIP_BACKUP_RESTORE_EVIDENCE=""

# Neon backup freshness gate用の非Secret JSON証跡。
# 接続文字列やAPI tokenは入れず、pg_dump artifact名、PITR window、restore drill結果だけを記録する。
CODIP_NEON_BACKUP_EVIDENCE_JSON=""

# e-Stat API アプリケーションID (値は https://www.e-stat.go.jp/api/ で取得し、ここに設定)
# APIキーの値は絶対に Git にコミットしないこと
ESTAT_APP_ID=""

# Cloudflare Access service token (release:post-release-status / production-smoke 用)
# 両方を必ず設定する。値はGitHub Actions Secretへ登録し、Gitへコミットしないこと
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""

# 定期収集ジョブ用の PostgreSQL 接続文字列 (write権限のある専用ロールを推奨)
# 値はGitHub Actions Secretへ登録し、Gitへコミットしないこと
CODIP_INGESTION_DATABASE_URL=""

# 1 tickあたりに実行する定期収集ジョブの上限 (既定3)
CODIP_INGESTION_MAX_JOBS_PER_TICK="3"

# 品質監視サマリーの集計ウィンドウ（時間）
CODIP_QUALITY_MONITOR_WINDOW_HOURS="24"
